# Exclude bot runtime files the dashboard function does not import.
# The dashboard only depends on: dashboard/**, server/db.js, server/welcomeDb.js,
# shared/schema.js, utils/prefixHelper.js, config.js — included via vercel.json.
# NOTE: `scripts/` must NOT be ignored — npm run vercel-build runs
# `node scripts/write-version.js`, and .vercelignore is applied before the build.
commands/
tests/
logs/
*.log
.git
.gitignore
.env
.env.local

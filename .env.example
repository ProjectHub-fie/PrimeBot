# Discord Bot Configuration
# DISCORD_TOKEN2 is the primary bot token (checked first by utils/tokenResolver.js).
DISCORD_TOKEN2=your_discord_bot_token_here
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=https://your-repl-url.replit.app/api/auth/callback

# PostgreSQL Database Configuration
# Option 1: Full connection string (recommended)
DATABASE_URL=postgresql://user:password@host:5432/database
# Shared fallback for every per-feature pool (*_DATABASE_URL) when its own var
# is unset. Falls back to DATABASE_URL when unset itself — optional.
# FALLBACK_DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Individual connection variables
DB_HOST=your_database_host
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_SSL=require

# Optional: separate database for welcome settings (defaults to DATABASE_URL if unset)
# WELCOME_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for automod settings/warnings/appeals/incidents (defaults to DATABASE_URL if unset)
# AUTOMOD_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the bot reverses dashboard-approved appeals (default 15000)
# APPEAL_POLL_INTERVAL_MS=15000
# Optional: how often (ms) the bot prunes old automod incidents per guild retention (default 3600000)
# AUTOMOD_RETENTION_INTERVAL_MS=3600000
# Optional: set to "false" to disable incident retention cleanup entirely
# AUTOMOD_RETENTION_ENABLED=true

# Optional: separate database for anti-nuke settings (defaults to DATABASE_URL if unset).
# ANTI_DATABASE_URL is canonical; ANUKE_DATABASE_URL is a backward-compatible alias.
# ANTI_DATABASE_URL=postgresql://user:password@host:5432/database
# ANUKE_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for ticket panels/instances (defaults to DATABASE_URL if unset)
# TICKET_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for live giveaways (defaults to DATABASE_URL if unset)
# Used by the live giveaway feature ($lgiveway / /lgiveway) and the dashboard Live page.
# LIVE_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for the legacy event SCHEDULES feature (timed
# lock/unlock channel schedules; 📅 Events tab's older subsystem).
# EVENT_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the legacy event scheduler wakes to fire due tasks (default 5000)
# EVENT_EXEC_INTERVAL_MS=5000

# Optional: separate database for EVENT MANAGEMENT (the premium event platform:
# events, participants/waiting list, reminders, attendance, activity log).
# Used by the bot's EventMgmtManager and the dashboard's Event Management tab.
# EVENTMGMT_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the bot's event scheduler wakes to advance statuses
# and fire reminders (default 60000).
# EVENTMGMT_TICK_INTERVAL_MS=60000
# Optional: separate database for YOUTUBE NOTIFICATIONS (subscriptions,
# announcement history, the cross-node polling lease). Used by the bot's
# YouTubeManager and the dashboard's YouTube tab. All three shard nodes and the
# dashboard must share it for the polling lease + duplicate guard to work.
# YOUTUBE_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the lease-holding node checks due feeds (default 180000 = 3 min).
# YOUTUBE_POLL_INTERVAL_MS=180000
# Optional: polling-lease TTL in seconds; a crashed node's lease is recovered after this (default 90).
# YOUTUBE_LEASE_TTL_SECONDS=90
# Optional: hard cap (ms) on the DASHBOARD's YouTube channel resolution (the
# "Add creator" flow resolves the reference via up to two external requests).
# Kept tight so a slow/throttled YouTube can never hold the serverless function
# open into a FUNCTION_INVOCATION_TIMEOUT (504). Default 8000.
# YOUTUBE_RESOLVE_TIMEOUT_MS=8000
# Optional: pacing between event role operations (ms) to protect Discord rate limits (default 1100).
# EVENT_ROLE_OP_DELAY_MS=1100
# Optional: pacing between event participant DMs (ms) (default 150).
# EVENT_DM_DELAY_MS=150

# ── Music (Linix music system on Lavalink) ───────────────────────────────────
# PrimeBot's music feature is the Linix music system: Kazagumo/Shoukaku talking
# to a Lavalink node. YouTube, SoundCloud and Spotify are resolved by the NODE's
# source plugins, so the bot process does no local decoding and needs no ffmpeg.
# Commands: /play /skip /queue /filter /autoplay /playlist /247 /radio …
#           $play $p $skip $fs $q $v $247 $filter $playlist …
#           ($np is PrimeBot's developer no-prefix command — use $nowplaying)
#
# Lavalink node — the ONLY required music configuration. The NODE_* names are
# the Linix-compatible ones; LAVALINK_* aliases are also accepted and win when
# both are set. NEVER commit real credentials.
#
# Authorized CloudWave node (plaintext!). For ANY node, NODE_URL must include
# the port (either inline as host:port, or via NODE_PORT). Dropping the port
# silently dials :80 and fails. NODE_SECURE defaults to **false** (plaintext);
# only set NODE_SECURE=true for a wss:// TLS node.
# NODE_URL=lavalink.cloudewave.in
# NODE_PORT=2336
# NODE_AUTH=cloudewave.in
# NODE_NAME=CloudeWave              (Lavalink display label; note this is also
#                                    PrimeBot's shard-node identity — prefer
#                                    LAVALINK_NAME for the Lavalink label when the
#                                    shard node identity must stay NODE_ID/NODE_NAME)
# NODE_SECURE=false                 (default false = plaintext; true only behind TLS)
#
# Equivalent LAVALINK_* form (preferred for multi-node deployments):
# LAVALINK_NODES=[{"name":"main","host":"lava.example.com","port":2333,"password":"CHANGE_ME","secure":false}]
# LAVALINK_HOST=lava.example.com
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=CHANGE_ME
# LAVALINK_SECURE=false
# LAVALINK_NAME=main
#
# Spotify resolution goes through the node (LavaSrc / a Spotify Lavalink plugin).
# PrimeBot passes the credentials to the node's Spotify plugin; without them a
# Spotify link is resolved to metadata and matched to a streamable track.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
#
# Optional tuning (defaults shown):
# LAVALINK_SEARCH_ENGINE=ytsearch        # ytsearch | ytmsearch | scsearch | ...
# LAVALINK_RECONNECT_TRIES=3             # Shoukaku reconnect attempts per node
# LAVALINK_RECONNECT_INTERVAL_MS=5000
# LAVALINK_REST_TIMEOUT_MS=10000
# LAVALINK_VOICE_TIMEOUT_S=20
#
# Display/branding values (all optional — Unicode defaults are used when unset):
# MUSIC_SUPPORT_URL=dashboard-support  # where music embeds link their support row
# MUSIC_POWERED_BY=PrimeBot            # footer text on the now-playing embeds
# MUSIC_CARD_IMAGE=                    # background image URL for the player-start card
# MUSIC_CARD_NAME=primebot-music.png   # attachment name for the generated card
# MUSIC_OWNER_ID=                      # avatar fallback for the `$playlist` card
#
# Custom-emoji overrides. Linix used its own public emoji server for every
# music emoji; PrimeBot defaults to Unicode so embeds render on any server. To
# use a custom emoji instead, set MUSIC_EMOJI_<KEY> to a full `<a:name:id>` /
# `<:name:id>` string (the emoji must be reachable by the bot).
# Music:  MUSIC_EMOJI_PLAY MUSIC_EMOJI_PAUSE MUSIC_EMOJI_SKIP MUSIC_EMOJI_STOP
#         MUSIC_EMOJI_LOOP MUSIC_EMOJI_SHUFFLE MUSIC_EMOJI_RESUME MUSIC_EMOJI_MUSIC
#         MUSIC_EMOJI_QUEUE MUSIC_EMOJI_VOLUMEHIGH MUSIC_EMOJI_DOT MUSIC_EMOJI_TICK
#         MUSIC_EMOJI_CROSS MUSIC_EMOJI_PLAYING MUSIC_EMOJI_LEFT MUSIC_EMOJI_RIGHT
#         MUSIC_EMOJI_DELETE MUSIC_EMOJI_REPLAY MUSIC_EMOJI_FILTER MUSIC_EMOJI_ADDSONG
#         MUSIC_EMOJI_PLAYLIST MUSIC_EMOJI_AUTOPLAY MUSIC_EMOJI_JOIN MUSIC_EMOJI_LEAVE
#         MUSIC_EMOJI_REMOVE MUSIC_EMOJI_FORWARD MUSIC_EMOJI_REWIND MUSIC_EMOJI_JUMP
#         MUSIC_EMOJI_PREVIOUS MUSIC_EMOJI_WARN MUSIC_EMOJI_ABOUT
#         (keys are the emoji names uppercased, e.g. MUSIC_EMOJI_ADDSONG for `addsong`)
#
# $playlist "Quick Playlists" demo menu. Linix bundled a hardcoded, vote-gated,
# Arrkiii-branded menu; PrimeBot ships it free and configurable. Either form:
# MUSIC_PLAYLISTS=[{"id":"hindi1","label":"Hindi Songs!","query":"https://open.spotify.com/playlist/..."}]
# …or the single-entry convenience form:
# MUSIC_PLAYLIST_LABEL=PrimeBot Playlist
# MUSIC_PLAYLIST_URL=https://open.spotify.com/playlist/...
# MUSIC_PLAYLIST_MENU_LABEL=PrimeBot Quick Playlists   # the select-menu title
# (with no entries configured, $playlist tells the user to set them up)

# ── Custom emoji catalog ────────────────────────────────────────────────────
# PrimeBot reuses the three existing emoji servers (no new server, no new bot).
# Each has a read-only channel named "emoji list"; the bot reads those channels
# and validates every emoji against the live guild emoji collection before use.
# Priority is left-to-right: when two guilds expose the same emoji name the
# first wins and the duplicate is reported.
EMOJI_GUILD_IDS=1190256755096158208,1127600524586401792,1222896507838009394
# Optional tuning (milliseconds unless noted):
# EMOJI_CACHE_TTL_MS=21600000        # 6 hours; emoji events also trigger a refresh
# EMOJI_FETCH_TIMEOUT_MS=8000
# EMOJI_MAX_RETRIES=3
# EMOJI_RETRY_BASE_MS=500
# EMOJI_LIST_MAX_MESSAGES=500        # messages read per `emoji list` channel
#
# The music system also reads the bot's per-guild prefix (server settings) for
# prefix commands, and it shares the ONE voice connection per guild with nothing
# else — music and radio are the same subsystem, so they can never both play.
#
# Optional: persistence for 24/7 sessions, playlists, presets and the voice
# channel status. Falls back to FALLBACK_DATABASE_URL then DATABASE_URL, so a
# single-database deployment needs nothing here. Tables are created on first use.
# MUSIC_DATABASE_URL=

# ── Infrastructure status monitoring (Stats page) ────────────────────────────
# Status-monitoring tables reuse the SEASON_DATABASE_URL pool (the same database
# as the shard-node failover service + dashboard sessions). In a single-DB setup
# that is FALLBACK_DATABASE_URL → DATABASE_URL, so NO new database is required.
# Optional: point the monitoring tables at their own database instead.
# MONITOR_DATABASE_URL=postgresql://user:password@host:5432/database
#
# Master switch for the status worker + heartbeats (default enabled - set to
# "false" to disable).
# STATUS_MONITOR_ENABLED=true
# How often (ms) the single status-monitoring worker (one node holds the DB
# lease) samples all components. Default 60000.
# STATUS_MONITOR_INTERVAL_MS=60000
# Status-worker lease TTL in seconds; a crashed holder's lease expires and
# another node recovers the work (default 90).
# STATUS_WORKER_TTL_S=90
# How often (ms) each node posts its own status pulse (standby nodes; the active
# node's pulse rides the failover heartbeat). Default 30000. The pulse carries
# its own cadence so the worker sizes the staleness window per writer.
# MONITOR_PULSE_INTERVAL_MS=30000
# Consecutive healthy readings required before an open incident is resolved, so
# a single flapping sample cannot close/re-open it. Default 2.
# STATUS_RECOVERY_CONFIRMATIONS=2
# Raw observation retention in days before pruning (daily aggregates are kept).
# Default 31.
# STATUS_RETENTION_DAYS=31
# The monitoring worker checks "Main Website" + "Dashboard/API" from these URLs.
# Falls back to DASHBOARD_BASE_URL when unset. Leave unset to skip external
# HTTP checks.
# MONITOR_WEBSITE_URL=https://your-project.vercel.app
# MONITOR_API_URL=https://your-project.vercel.app/api/status/ping

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Environment
NODE_ENV=development
PORT=5000

# Dashboard Configuration
# Port the dashboard web server listens on (default 3000)
DASHBOARD_PORT=3000
# Public base URL used to build the OAuth2 redirect URI (defaults to http://localhost:<DASHBOARD_PORT>)
DASHBOARD_BASE_URL=http://localhost:3000
# OAuth2 callback path — must match a redirect URI added in the Discord Developer Portal
# Default: <DASHBOARD_BASE_URL>/auth/callback
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Vercel deployment notes ──────────────────────────────────────────────────
# On Vercel, DO NOT set DASHBOARD_BASE_URL or DISCORD_REDIRECT_URI to localhost.
# Instead, set them to your production URL, e.g.:
#   DASHBOARD_BASE_URL=https://your-project.vercel.app
#   DISCORD_REDIRECT_URI=https://your-project.vercel.app/auth/callback
# And add that exact redirect URI in the Discord Developer Portal → OAuth2 → Redirects.
#
# Sessions are stored in PostgreSQL (table `primebot_dashboard_session`, created
# automatically on first login) so login survives Vercel's serverless cold starts.
# All of these must be set in Vercel → Settings → Environment Variables:
#   DISCORD_TOKEN, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
#   DATABASE_URL, SESSION_SECRET, DISCORD_REDIRECT_URI, DASHBOARD_BASE_URL

# Voice defense — the bot is always self-deafened in voice (it still transmits
# playback). Set VOICE_DEFEND_ENABLED=false to opt out (not recommended).
VOICE_DEFEND_ENABLED=true
# Throttle for re-asserting a lost deafen per guild (ms). Default 30000.
VOICE_DEFEND_COOLDOWN_MS=30000

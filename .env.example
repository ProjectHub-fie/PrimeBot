# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=https://your-repl-url.replit.app/api/auth/callback

# PostgreSQL Database Configuration
# Option 1: Full connection string (recommended)
DATABASE_URL=postgresql://user:password@host:5432/database

# Option 2: Individual connection variables
DB_HOST=your_database_host
DB_PORT=5432
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_NAME=your_database_name
DB_SSL=require

# Optional: separate database for welcome settings (defaults to DATABASE_URL if unset)
# WELCOME_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for automod settings/warnings/appeals (defaults to DATABASE_URL if unset)
# AUTOMOD_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the bot reverses dashboard-approved appeals (default 15000)
# APPEAL_POLL_INTERVAL_MS=15000

# Optional: separate database for ticket panels/instances (defaults to DATABASE_URL if unset)
# TICKET_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for live giveaways (defaults to DATABASE_URL if unset)
# Used by the live giveaway feature ($lgiveway / /lgiveway) and the dashboard Live page.
# LIVE_DATABASE_URL=postgresql://user:password@host:5432/database

# Optional: separate database for event management (defaults to DATABASE_URL if unset)
# Used by the event management feature (📅 Events tab) and the bot's EventManager.
# EVENT_DATABASE_URL=postgresql://user:password@host:5432/database
# Optional: how often (ms) the bot's event scheduler wakes to fire due tasks (default 5000)
# EVENT_EXEC_INTERVAL_MS=5000

# Session Configuration
SESSION_SECRET=your_session_secret_here

# Environment
NODE_ENV=development
PORT=5000

# Dashboard Configuration
# Port the dashboard web server listens on (default 3000)
DASHBOARD_PORT=3000
# Public base URL used to build the OAuth2 redirect URI (defaults to http://localhost:<DASHBOARD_PORT>)
DASHBOARD_BASE_URL=http://localhost:3000
# OAuth2 callback path — must match a redirect URI added in the Discord Developer Portal
# Default: <DASHBOARD_BASE_URL>/auth/callback
# DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# ── Vercel deployment notes ──────────────────────────────────────────────────
# On Vercel, DO NOT set DASHBOARD_BASE_URL or DISCORD_REDIRECT_URI to localhost.
# Instead, set them to your production URL, e.g.:
#   DASHBOARD_BASE_URL=https://your-project.vercel.app
#   DISCORD_REDIRECT_URI=https://your-project.vercel.app/auth/callback
# And add that exact redirect URI in the Discord Developer Portal → OAuth2 → Redirects.
#
# Sessions are stored in PostgreSQL (table `primebot_dashboard_session`, created
# automatically on first login) so login survives Vercel's serverless cold starts.
# All of these must be set in Vercel → Settings → Environment Variables:
#   DISCORD_TOKEN, DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET,
#   DATABASE_URL, SESSION_SECRET, DISCORD_REDIRECT_URI, DASHBOARD_BASE_URL

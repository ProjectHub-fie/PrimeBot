{
  "version": 2,
  "framework": null,
  "buildCommand": "node scripts/write-version.js",
  "builds": [
    {
      "src": "dashboard/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["dashboard/**", "server/**", "shared/**", "utils/**", "config.js"],
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/dashboard/server.js" }
  ]
}


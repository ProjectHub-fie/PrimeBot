# Pin the public npm registry. The lockfile was originally generated on
# Replit, which proxies packages through http://package-firewall.replit.local.
# That host is unreachable off Replit (e.g. on Vercel → ENOTFOUND during
# `npm install`). This file forces npm to use the real registry regardless of
# any inherited environment config.
registry=https://registry.npmjs.org/
